# ⚠️ VULNERABLE DOCKERFILE - FOR EDUCATIONAL PURPOSES ONLY ⚠️
# This Dockerfile contains intentional security misconfigurations
# File: Dockerfile.vuln

# VULNERABILITY 1: Unpinned base image (uses 'latest' tag)
# Risk: Non-deterministic builds, potential breaking changes
FROM python:latest

# VULNERABILITY 2: Hardcoded secret in environment variable
# Risk: Secrets exposed in image layers, accessible via 'docker inspect'
ENV API_KEY=super_secret_api_key_12345
ENV SECRET_TOKEN=hardcoded_token_xyz789
ENV APP_ENV=production

# VULNERABILITY 3: Installing unnecessary packages
# Risk: Increases attack surface, larger image size, more CVEs
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    vim \
    nano \
    net-tools \
    netcat-traditional \
    telnet \
    openssh-server \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy application files
# VULNERABILITY 4: No .dockerignore file
# Risk: May include sensitive files, .git, secrets, etc.
COPY app/app.py .

# Install Python dependencies
RUN pip install --no-cache-dir Flask==3.0.0 Werkzeug==3.0.1

# VULNERABILITY 5: Exposing unnecessary ports
# Risk: Increased attack surface, unnecessary services exposed
EXPOSE 5000
EXPOSE 8080
EXPOSE 3000
EXPOSE 22
EXPOSE 443

# VULNERABILITY 6: Running as root user (default)
# Risk: If container is compromised, attacker has root privileges
# No USER directive = runs as root (UID 0)

# VULNERABILITY 7: Debug mode enabled in production
ENV FLASK_DEBUG=1

# Set environment variable for Flask
ENV FLASK_APP=app.py

# VULNERABILITY 8: No health check defined
# Risk: Orchestrators can't detect unhealthy containers

# Run the application as root
CMD ["python", "app.py"]
